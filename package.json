{
  "name": "polylayer",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Polylayer API — Bearer-keyed trading on Polymarket, Hyperliquid, and Jupiter Perpetuals.",
  "license": "MIT",
  "homepage": "https://polylayer.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/polylayer/polylayer-ts.git"
  },
  "keywords": [
    "polylayer",
    "polymarket",
    "hyperliquid",
    "jupiter",
    "perps",
    "prediction-markets",
    "trading",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
